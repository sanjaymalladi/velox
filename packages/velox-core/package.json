{
  "name": "@velox-video/core",
  "version": "2.0.0",
  "description": "LLM-friendly motion graphics engine with deterministic Canvas rendering",
  "author": "sanjaymalladi <sanjaymalladi16@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanjaymalladi/velox.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./node-render": {
      "types": "./dist/node-render.d.mts",
      "import": "./dist/node-render.mjs",
      "node": "./dist/node-render.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external @napi-rs/canvas && tsup src/node-render.ts --format esm --dts --no-clean --external @napi-rs/canvas --tsconfig tsconfig.node-render.json",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external @napi-rs/canvas",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "sync:aesthetics": "tsx ../../scripts/sync-aesthetics.ts"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.97",
    "@types/chroma-js": "^3.1.2",
    "@types/culori": "^4.0.1",
    "@types/d3": "^7.4.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/flubber": "^0.4.0",
    "@types/node": "^22.15.21",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.4.5",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "video",
    "motion-graphics",
    "animation",
    "canvas",
    "video-rendering",
    "generative-video",
    "xml",
    "vml",
    "llm",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@velox-video/svgl": "workspace:^",
    "chroma-js": "^3.2.0",
    "culori": "^4.0.2",
    "d3": "^7.9.0",
    "flubber": "^0.4.2",
    "popmotion": "^11.0.5",
    "simplex-noise": "^4.0.3",
    "stackblur-canvas": "^2.7.0"
  }
}
